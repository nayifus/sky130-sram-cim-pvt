.save v(CL0) v(CL1) v(CL2) v(CL3)

.control
set cname = ss
foreach vv 1.62 1.8 1.98
  foreach tv -40 27 125
    foreach pv 255 173 0 170 85 15 240 1 127 118 201 60
      alterparam vdd_v=$vv
      alterparam tmp=$tv
      alterparam pat=$pv
      reset
      run
      meas tran c0 find v(cl0) at=13n
      meas tran c1 find v(cl1) at=13n
      meas tran c2 find v(cl2) at=13n
      meas tran c3 find v(cl3) at=13n
      echo $cname $vv $tv $pv $&c0 $&c1 $&c2 $&c3 >> array_pvt.csv
    end
  end
end
